{%- props
    ## string Heading.
    title = 'Factures',
    ## string Search form action (GET, parameter "q").
    searchAction = '#',
    ## array<array{number: string, client: string, date: string, amount: string, status: 'paid'|'pending'|'late'|'draft'}> Rows.
    rows = [
        {number: 'F-2026-0142', client: 'Atelier Moreau', date: '18/11/2026', amount: '3 636,00 €', status: 'pending'},
        {number: 'F-2026-0141', client: 'Studio Lune', date: '15/11/2026', amount: '1 200,00 €', status: 'paid'},
        {number: 'F-2026-0140', client: 'Cabinet Roux', date: '02/11/2026', amount: '840,00 €', status: 'late'},
        {number: 'F-2026-0139', client: 'Boulangerie Petit', date: '28/10/2026', amount: '96,00 €', status: 'paid'},
        {number: 'F-2026-0138', client: 'Agence Nord', date: '—', amount: '5 400,00 €', status: 'draft'},
    ],
    ## array<string, array{label: string, variant: string}> Status labels and badge variants.
    statuses = {
        paid: {label: 'Payée', variant: 'secondary'},
        pending: {label: 'En attente', variant: 'outline'},
        late: {label: 'En retard', variant: 'destructive'},
        draft: {label: 'Brouillon', variant: 'ghost'},
    },
    ## int Current page.
    page = 1,
    ## int Number of pages.
    pages = 3,
    ## string Summary under the table, e.g. "5 sur 42 factures".
    summary = '1 à 5 sur 14 factures'
-%}
<section {{ attributes.defaults({class: 'space-y-4 p-4 sm:p-6'|tailwind_classes}) }}>
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-xl font-semibold tracking-tight">{{ title }}</h2>
        <div class="flex flex-wrap gap-2">
            <form action="{{ searchAction }}" role="search" class="relative">
                <label for="table-q" class="sr-only">Rechercher</label>
                <twig:ux:icon name="lucide:search" class="pointer-events-none absolute start-2.5 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
                <twig:Input id="table-q" type="search" name="q" placeholder="Client, numéro…" class="w-56 ps-8" />
            </form>
            {%- block actions -%}
                <twig:Button variant="outline"><twig:ux:icon name="lucide:download" />Exporter</twig:Button>
                <twig:Button><twig:ux:icon name="lucide:plus" />Nouvelle facture</twig:Button>
            {%- endblock -%}
        </div>
    </div>
    <div class="overflow-hidden rounded-xl border">
        <twig:Table>
            <twig:Table:Header class="bg-muted/50">
                <twig:Table:Row>
                    <twig:Table:Head>Numéro</twig:Table:Head>
                    <twig:Table:Head>Client</twig:Table:Head>
                    <twig:Table:Head class="hidden sm:table-cell">Date</twig:Table:Head>
                    <twig:Table:Head>Statut</twig:Table:Head>
                    <twig:Table:Head class="text-end">Montant TTC</twig:Table:Head>
                </twig:Table:Row>
            </twig:Table:Header>
            <twig:Table:Body>
                {%- for row in rows %}
                    {%- set s = statuses[row.status] %}
                    <twig:Table:Row>
                        <twig:Table:Cell class="font-medium"><a href="#" class="hover:underline">{{ row.number }}</a></twig:Table:Cell>
                        <twig:Table:Cell>{{ row.client }}</twig:Table:Cell>
                        <twig:Table:Cell class="hidden text-muted-foreground sm:table-cell">{{ row.date }}</twig:Table:Cell>
                        <twig:Table:Cell><twig:Badge variant="{{ s.variant }}">{{ s.label }}</twig:Badge></twig:Table:Cell>
                        <twig:Table:Cell class="text-end tabular-nums">{{ row.amount }}</twig:Table:Cell>
                    </twig:Table:Row>
                {%- endfor %}
            </twig:Table:Body>
        </twig:Table>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 text-sm text-muted-foreground">
        <p>{{ summary }}</p>
        <twig:Pagination class="mx-0 w-auto justify-end">
            <twig:Pagination:Content>
                <twig:Pagination:Item><twig:Pagination:Previous href="#" text="Précédent" aria-label="Page précédente" /></twig:Pagination:Item>
                {%- for p in 1..pages %}
                    <twig:Pagination:Item><twig:Pagination:Link href="#" active="{{ p == page }}">{{ p }}</twig:Pagination:Link></twig:Pagination:Item>
                {%- endfor %}
                <twig:Pagination:Item><twig:Pagination:Next href="#" text="Suivant" aria-label="Page suivante" /></twig:Pagination:Item>
            </twig:Pagination:Content>
        </twig:Pagination>
    </div>
</section>
