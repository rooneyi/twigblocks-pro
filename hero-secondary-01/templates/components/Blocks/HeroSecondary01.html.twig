{#- Hero secondaire centré : titre, sous-titre, bouton, puis grande capture produit sur un halo, et bandeau de logos. -#}
{%- props
    ## string Heading.
    title = 'Repérez les impayés avant qu’ils coûtent',
    ## string Supporting text.
    description = 'Facturo croise vos factures, vos encaissements et vos relances pour vous dire, chaque matin, qui relancer et quand.',
    ## string Primary button label.
    primaryLabel = 'Essayer gratuitement',
    ## string Primary button URL.
    primaryHref = '#',
    ## string Small note under the button.
    note = 'Sans carte bancaire',
    ## string|null Product screenshot URL. Null shows an empty frame.
    image = null,
    ## string Alternative text of the screenshot.
    imageAlt = 'Tableau de bord Facturo',
    ## string Sentence above the logos.
    logosTitle = 'Utilisé par des cabinets, des agences et des artisans en France, en Belgique et en RDC',
    ## array<string> Customer names shown as wordmarks.
    logos = ['Atelier Saône', 'Kivu Logistique', 'Maison Ferrand', 'Brasserie Haute', 'Cabinet Lys', 'Nordkap']
-%}
<section {{ attributes.defaults({class: 'relative overflow-hidden px-4 pt-24 pb-16 sm:px-6'|tailwind_classes}) }}>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[36rem] bg-[radial-gradient(60%_50%_at_50%_0%,color-mix(in_oklab,var(--primary)_14%,transparent),transparent)]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl text-center">
        <h1 class="mx-auto max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-6xl">{{ title }}</h1>
        <p class="mx-auto mt-6 max-w-xl text-lg text-pretty text-muted-foreground">{{ description }}</p>
        <div class="mt-8 flex flex-col items-center gap-2">
            <twig:Button as="a" href="{{ primaryHref }}" size="lg" class="rounded-full">{{ primaryLabel }}<twig:ux:icon name="lucide:arrow-right" class="size-4" /></twig:Button>
            <span class="text-xs text-muted-foreground">{{ note }}</span>
        </div>
    </div>
    <div class="relative mx-auto mt-16 max-w-5xl">
        <div class="rounded-2xl border bg-background/60 p-2 shadow-2xl shadow-primary/10 ring-1 ring-black/5 backdrop-blur">
            {%- if image %}<img src="{{ image }}" alt="{{ imageAlt }}" class="w-full rounded-xl border" loading="lazy">{% else %}<div class="aspect-[16/10] rounded-xl border bg-muted"></div>{% endif %}
        </div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-background to-transparent" aria-hidden="true"></div>
    </div>
    <div class="relative mx-auto mt-4 max-w-3xl text-center">
        <p class="text-sm text-balance text-muted-foreground">{{ logosTitle }}</p>
        <ul class="mt-6 grid grid-cols-2 gap-x-8 gap-y-4 text-base font-semibold text-foreground/70 sm:grid-cols-3">
            {%- for l in logos %}<li class="{{ loop.index is odd ? 'tracking-tight' : 'font-serif italic' }}">{{ l }}</li>{% endfor %}
        </ul>
    </div>
</section>
