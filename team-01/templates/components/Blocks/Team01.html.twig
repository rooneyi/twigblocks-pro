{#- Contenu de démonstration : remplacez par votre équipe. -#}
{%- props
    ## string Heading.
    title = 'L’équipe qui répond à vos e-mails',
    ## string Supporting text.
    description = 'Pas de centre d’appels : ce sont les personnes qui construisent Lumen qui vous répondent.',
    ## array<array{name: string, role: string, photo?: string}> Team members.
    members = [
        {name: 'Lucien Ntwali', role: 'Fondateur'},
        {name: 'Augustin Paisible', role: 'Directeur technique'},
        {name: 'Jonathan Bolibenga', role: 'Designer produit'},
        {name: 'Simplice Bondo', role: 'Développeur Symfony'},
        {name: 'Philemon Kambale', role: 'Responsable commercial'},
    ]
-%}
<section {{ attributes.defaults({class: 'px-4 py-20 sm:px-6'|tailwind_classes}) }}>
    <div class="mx-auto max-w-6xl">
        <div class="max-w-2xl">
            <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{{ title }}</h2>
            <p class="mt-4 text-lg text-muted-foreground">{{ description }}</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-5">
            {%- for member in members %}
                <li>
                    <div class="aspect-square overflow-hidden rounded-xl bg-muted">
                        {%- if member.photo is defined %}
                            <img src="{{ member.photo }}" alt="" class="size-full object-cover" loading="lazy">
                        {%- else %}
                            <span class="grid size-full place-items-center text-3xl font-semibold text-muted-foreground/60">{{ member.name|split(' ')|map(w => w|first)|join|slice(0, 2)|upper }}</span>
                        {%- endif %}
                    </div>
                    <p class="mt-3 font-medium">{{ member.name }}</p>
                    <p class="text-sm text-muted-foreground">{{ member.role }}</p>
                </li>
            {%- endfor %}
        </ul>
    </div>
</section>
