{#- Offres d'emploi groupées par équipe : intitulé, lieu, contrat, lien. -#}
{%- props
    ## string Heading.
    title = 'Rejoignez-nous',
    ## string Supporting text.
    description = 'Nous sommes 24, répartis entre Lyon, Bruxelles et Kinshasa. Télétravail possible partout, deux semaines ensemble par an.',
    ## array<array{team: string, jobs: array<array{title: string, location: string, type: string, href: string}>}> Open roles by team.
    teams = [
        {team: 'Produit et technique', jobs: [
            {title: 'Développeur ou développeuse Symfony confirmé·e', location: 'Lyon ou à distance', type: 'CDI', href: '#'},
            {title: 'Ingénieur·e données', location: 'Kinshasa', type: 'CDI', href: '#'},
            {title: 'Designer produit', location: 'Bruxelles', type: 'CDI', href: '#'},
        ]},
        {team: 'Clients', jobs: [
            {title: 'Chargé·e de clientèle', location: 'Lyon', type: 'CDI', href: '#'},
            {title: 'Alternance : support client', location: 'Kinshasa', type: 'Alternance', href: '#'},
        ]},
        {team: 'Commercial', jobs: [
            {title: 'Responsable partenariats cabinets comptables', location: 'Paris ou Lyon', type: 'CDI', href: '#'},
        ]},
    ],
    ## string Text shown when no role fits.
    spontaneous = 'Aucune offre ne vous correspond ? Écrivez-nous quand même :',
    ## string Contact e-mail.
    email = 'jobs@exemple.fr'
-%}
<section {{ attributes.defaults({class: 'px-4 py-20 sm:px-6'|tailwind_classes}) }}>
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_2fr]">
        <div>
            <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{{ title }}</h2>
            <p class="mt-4 text-muted-foreground">{{ description }}</p>
            <p class="mt-8 text-sm text-muted-foreground">{{ spontaneous }} <a href="mailto:{{ email }}" class="font-medium text-foreground underline underline-offset-4">{{ email }}</a></p>
        </div>
        <div class="space-y-10">
            {%- for t in teams %}
                <div>
                    <h3 class="flex items-center gap-2 text-sm font-medium text-muted-foreground">{{ t.team }}<span class="rounded-full bg-muted px-2 py-0.5 text-xs tabular-nums">{{ t.jobs|length }}</span></h3>
                    <ul class="mt-3 divide-y rounded-xl border bg-card">
                        {%- for j in t.jobs %}
                            <li class="group relative flex flex-wrap items-center gap-x-4 gap-y-2 p-4 transition hover:bg-muted/40">
                                <a href="{{ j.href }}" class="font-medium after:absolute after:inset-0">{{ j.title }}</a>
                                <span class="flex items-center gap-1 text-sm text-muted-foreground sm:ms-auto"><twig:ux:icon name="lucide:map-pin" class="size-3.5" />{{ j.location }}</span>
                                <span class="rounded-full border px-2.5 py-0.5 text-xs">{{ j.type }}</span>
                                <twig:ux:icon name="lucide:arrow-up-right" class="size-4 text-muted-foreground transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-foreground" />
                            </li>
                        {%- endfor %}
                    </ul>
                </div>
            {%- endfor %}
        </div>
    </div>
</section>
