{%- props
    ## array<array{title: string, cards: array<array{title: string, tag?: string, due?: string, people?: array<string>}>}> Columns.
    columns = [
        {title: 'À faire', cards: [
            {title: 'Relancer Cabinet Roux', tag: 'Relance', due: '22 nov.', people: ['CD']},
            {title: 'Préparer le devis Agence Nord', tag: 'Devis', people: ['TM', 'CD']},
        ]},
        {title: 'En cours', cards: [
            {title: 'Rapprochement bancaire d’octobre', tag: 'Compta', due: 'Aujourd’hui', people: ['JL']},
            {title: 'Nouvelle grille tarifaire 2027', people: ['CD', 'JL', 'TM']},
        ]},
        {title: 'Terminé', cards: [
            {title: 'Export FEC du T3', tag: 'Compta', people: ['JL']},
            {title: 'Facture F-2026-0141 payée', tag: 'Relance', people: ['CD']},
        ]},
    ]
-%}
<section {{ attributes.defaults({class: 'p-4 sm:p-6'|tailwind_classes}) }}>
    <div class="grid gap-4 md:grid-cols-{{ columns|length }}">
        {%- for col in columns %}
            <section class="flex flex-col rounded-xl bg-muted/60 p-3" aria-labelledby="kanban-col-{{ loop.index }}">
                <header class="mb-3 flex items-center justify-between px-1">
                    <h3 id="kanban-col-{{ loop.index }}" class="text-sm font-semibold">{{ col.title }} <span class="ms-1 font-normal text-muted-foreground tabular-nums">{{ col.cards|length }}</span></h3>
                    <twig:Button variant="ghost" size="icon-sm" aria-label="Ajouter une carte dans {{ col.title }}"><twig:ux:icon name="lucide:plus" /></twig:Button>
                </header>
                <ul class="space-y-2">
                    {%- for card in col.cards %}
                        <li class="rounded-lg border bg-card p-3 shadow-xs">
                            {%- if card.tag is defined %}<twig:Badge variant="secondary" class="mb-2">{{ card.tag }}</twig:Badge>{% endif %}
                            <p class="text-sm font-medium">{{ card.title }}</p>
                            <div class="mt-3 flex items-center justify-between">
                                {%- if card.due is defined %}<span class="flex items-center gap-1 text-xs text-muted-foreground"><twig:ux:icon name="lucide:calendar" class="size-3.5" />{{ card.due }}</span>{% else %}<span></span>{% endif %}
                                <div class="flex -space-x-2">
                                    {%- for p in card.people ?? [] %}<twig:Avatar class="size-6 ring-2 ring-card"><twig:Avatar:Fallback class="text-[10px]">{{ p }}</twig:Avatar:Fallback></twig:Avatar>{% endfor %}
                                </div>
                            </div>
                        </li>
                    {%- endfor %}
                </ul>
            </section>
        {%- endfor %}
    </div>
</section>
