{#- Deux articles à la une avec grande couverture, puis une grille « Plus d'articles » à bordures fines. -#}
{%- props
    ## string Small label above the heading.
    eyebrow = 'Blog',
    ## string Heading. The part before the separator is shown in a lighter tone.
    title = 'Conseils, nouveautés et coulisses|de l’équipe Facturo',
    ## array<array{date: string, title: string, excerpt: string, href: string, cover?: string, authors: array<string>}> Featured articles (2).
    featured = [
        {date: '18 nov. 2026', title: 'Envoyer ses relances sans passer pour un huissier : trois modèles testés sur 2 000 factures', excerpt: 'Ce qui a vraiment fait payer, ce qui a fait fuir, et le message que nous envoyons désormais par défaut.', href: '#', authors: ['Clara Fontaine', 'Thomas Girard']},
        {date: '4 nov. 2026', title: 'Facture électronique : ce qui change pour une PME de 10 personnes en 2027', excerpt: 'Le calendrier, les formats acceptés et la plateforme à choisir, sans jargon.', href: '#', authors: ['Aïcha Mbaye']},
    ],
    ## string Heading of the secondary grid.
    moreTitle = 'Plus d’articles',
    ## array<array{date: string, title: string, excerpt: string, href: string, authors: array<string>}> Other articles.
    more = [
        {date: '21 oct. 2026', title: 'Prévoir sa trésorerie à 90 jours', excerpt: 'Un tableau, trois hypothèses et une alerte.', href: '#', authors: ['Kevin Mulamba']},
        {date: '9 oct. 2026', title: 'Tous les exports comptables deviennent gratuits', excerpt: 'Pourquoi nous avons retiré cette option payante.', href: '#', authors: ['Nadège Kabeya']},
        {date: '2 oct. 2026', title: 'Relancer un client public sans se perdre', excerpt: 'Chorus Pro, délais légaux et intérêts de retard.', href: '#', authors: ['Hugo Lambert']},
        {date: '25 sept. 2026', title: 'Notre feuille de route pour 2027', excerpt: 'Ce que nous construisons, et ce que nous refusons.', href: '#', authors: ['Grace Ilunga']},
        {date: '18 sept. 2026', title: 'Facturer en dollars depuis Kinshasa', excerpt: 'Devises, taux et mentions obligatoires.', href: '#', authors: ['Samuel Okito']},
        {date: '11 sept. 2026', title: 'Le devis qui se signe sur mobile', excerpt: 'Une nouveauté demandée par 400 artisans.', href: '#', authors: ['Inès Moreau']},
    ],
    ## array<string> Cover images for featured articles without a cover.
    images = [],
    ## array<string> Author photos, in the order authors appear.
    avatars = []
-%}
{%- set parts = title|split('|') -%}
<section {{ attributes.defaults({class: 'px-4 py-20 sm:px-6'|tailwind_classes}) }}>
    <div class="mx-auto max-w-6xl">
        <p class="text-sm font-medium text-muted-foreground">{{ eyebrow }}</p>
        <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl"><span class="text-muted-foreground">{{ parts[0] }}</span>{% if parts[1] is defined %} {{ parts[1] }}{% endif %}</h2>
        {%- set a = 0 -%}
        <div class="mt-12 grid gap-8 md:grid-cols-2">
            {%- for p in featured %}
                {%- set cover = p.cover ?? images[loop.index0] ?? null %}
                <article class="group relative">
                    <div class="aspect-[16/9] overflow-hidden rounded-xl border bg-muted p-1.5 shadow-xs">
                        {%- if cover %}<img src="{{ cover }}" alt="" loading="lazy" class="size-full rounded-lg object-cover transition duration-700 group-hover:scale-[1.02] motion-reduce:group-hover:scale-100">{% endif %}
                    </div>
                    <p class="mt-5 text-sm text-muted-foreground"><time>{{ p.date }}</time></p>
                    <h3 class="mt-2 text-xl font-semibold text-pretty"><a href="{{ p.href }}" class="after:absolute after:inset-0">{{ p.title }}</a></h3>
                    <p class="mt-2 text-muted-foreground">{{ p.excerpt }}</p>
                    <div class="mt-5 flex items-center justify-between">
                        <ul class="space-y-1.5 text-sm">
                            {%- for au in p.authors %}{% set photo = avatars[a] ?? null %}{% set a = a + 1 %}
                                <li class="flex items-center gap-2">{% if photo %}<img src="{{ photo }}" alt="" class="size-6 rounded-full object-cover" loading="lazy">{% else %}<span class="grid size-6 place-items-center rounded-full bg-muted text-[10px] font-medium">{{ au|split(' ')|map(w => w|first)|join|slice(0, 2) }}</span>{% endif %}{{ au }}</li>
                            {%- endfor %}
                        </ul>
                        <span class="flex items-center text-sm font-medium text-primary">Lire<twig:ux:icon name="lucide:chevron-right" class="size-4 transition-transform group-hover:translate-x-0.5" /></span>
                    </div>
                </article>
            {%- endfor %}
        </div>
        <div class="relative mt-20 border-y">
            <p class="border-b px-5 py-3 text-xs font-medium tracking-wide text-muted-foreground">{{ moreTitle }}</p>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3">
                {%- for p in more %}
                    <article class="group relative flex flex-col border-b p-6 sm:[&:nth-child(odd)]:border-e lg:border-e lg:[&:nth-child(3n)]:border-e-0 lg:[&:nth-last-child(-n+3)]:border-b-0">
                        <p class="text-sm text-muted-foreground"><time>{{ p.date }}</time></p>
                        <h3 class="mt-2 font-semibold text-pretty"><a href="{{ p.href }}" class="after:absolute after:inset-0">{{ p.title }}</a></h3>
                        <p class="mt-2 text-sm text-muted-foreground">{{ p.excerpt }}</p>
                        <div class="mt-6 flex items-center justify-between text-sm">
                            {%- set au = p.authors|first %}{% set photo = avatars[a] ?? null %}{% set a = a + p.authors|length %}
                            <span class="flex items-center gap-2">{% if photo %}<img src="{{ photo }}" alt="" class="size-6 rounded-full object-cover" loading="lazy">{% else %}<span class="grid size-6 place-items-center rounded-full bg-muted text-[10px] font-medium">{{ au|split(' ')|map(w => w|first)|join|slice(0, 2) }}</span>{% endif %}{{ au }}</span>
                            <span class="flex items-center font-medium text-primary">Lire<twig:ux:icon name="lucide:chevron-right" class="size-4" /></span>
                        </div>
                    </article>
                {%- endfor %}
            </div>
            {%- for pos in ['-top-1.5 -left-1.5', '-top-1.5 -right-1.5', '-bottom-1.5 -left-1.5', '-bottom-1.5 -right-1.5'] %}<span class="pointer-events-none absolute {{ pos }} size-3 text-muted-foreground/60" aria-hidden="true"><svg viewBox="0 0 12 12" class="size-3"><path d="M6 0v12M0 6h12" stroke="currentColor"/></svg></span>{% endfor %}
        </div>
    </div>
</section>
