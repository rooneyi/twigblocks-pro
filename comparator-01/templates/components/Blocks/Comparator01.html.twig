{#- Tableau comparatif des offres : en-tête collant, groupes de lignes, coches et valeurs. -#}
{%- props
    ## string Heading.
    title = 'Comparer les offres',
    ## array<array{name: string, price: string, href: string, featured?: bool}> Plans (columns).
    plans = [
        {name: 'Solo', price: '0 €', href: '#'},
        {name: 'Équipe', price: '19 € / mois', href: '#', featured: true},
        {name: 'Entreprise', price: 'Sur devis', href: '#'},
    ],
    ## array<array{group: string, rows: array<array{label: string, values: array<bool|string>}>}> Feature groups. A value true shows a check, false a dash, a string is printed.
    groups = [
        {group: 'Facturation', rows: [
            {label: 'Factures et devis', values: ['20 / mois', 'Illimités', 'Illimités']},
            {label: 'Facture électronique', values: [true, true, true]},
            {label: 'Factures récurrentes', values: [false, true, true]},
            {label: 'Multi-devises', values: [false, true, true]},
        ]},
        {group: 'Encaissement', rows: [
            {label: 'Lien de paiement', values: [true, true, true]},
            {label: 'Relances automatiques', values: [false, true, true]},
            {label: 'Rapprochement bancaire', values: ['1 compte', '5 comptes', 'Illimité']},
        ]},
        {group: 'Équipe et sécurité', rows: [
            {label: 'Utilisateurs', values: ['1', '10', 'Illimités']},
            {label: 'Rôles et permissions', values: [false, true, true]},
            {label: 'Authentification unique (SSO)', values: [false, false, true]},
            {label: 'Interlocuteur dédié', values: [false, false, true]},
        ]},
    ],
    ## string Button label.
    ctaLabel = 'Choisir'
-%}
<section {{ attributes.defaults({class: 'px-4 py-20 sm:px-6'|tailwind_classes}) }}>
    <div class="mx-auto max-w-5xl">
        <h2 class="text-center text-3xl font-semibold tracking-tight sm:text-4xl">{{ title }}</h2>
        <div class="mt-12 overflow-x-auto">
            <table class="w-full min-w-[40rem] border-separate border-spacing-0 text-sm">
                <thead>
                    <tr>
                        <td class="sticky top-0 w-1/3 bg-background"></td>
                        {%- for p in plans %}
                            <th scope="col" class="sticky top-0 bg-background px-4 pb-6 text-left align-bottom font-normal">
                                <span class="block text-base font-semibold">{{ p.name }}{% if p.featured ?? false %} <span class="ms-1 rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">Populaire</span>{% endif %}</span>
                                <span class="mt-1 block text-muted-foreground">{{ p.price }}</span>
                                <twig:Button as="a" href="{{ p.href }}" size="sm" variant="{{ (p.featured ?? false) ? 'default' : 'outline' }}" class="mt-4 w-full">{{ ctaLabel }}</twig:Button>
                            </th>
                        {%- endfor %}
                    </tr>
                </thead>
                {%- for g in groups %}
                    <tbody>
                        <tr><th scope="colgroup" colspan="{{ plans|length + 1 }}" class="border-b px-0 pt-8 pb-3 text-left font-semibold">{{ g.group }}</th></tr>
                        {%- for r in g.rows %}
                            <tr class="hover:bg-muted/40">
                                <th scope="row" class="border-b border-dashed py-3 pe-4 text-left font-normal text-muted-foreground">{{ r.label }}</th>
                                {%- for v in r.values %}
                                    <td class="border-b border-dashed px-4 py-3 {{ (plans[loop.index0].featured ?? false) ? 'bg-primary/[0.03]' : '' }}">
                                        {%- if v is same as(true) %}<twig:ux:icon name="lucide:check" class="size-4 text-primary" aria-label="Inclus" />
                                        {%- elseif v is same as(false) %}<twig:ux:icon name="lucide:minus" class="size-4 text-muted-foreground/50" aria-label="Non inclus" />
                                        {%- else %}<span class="font-medium tabular-nums">{{ v }}</span>{% endif %}
                                    </td>
                                {%- endfor %}
                            </tr>
                        {%- endfor %}
                    </tbody>
                {%- endfor %}
            </table>
        </div>
    </div>
</section>
