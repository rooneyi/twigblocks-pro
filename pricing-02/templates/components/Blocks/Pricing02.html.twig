{#- Tarifs avec bascule mensuel / annuel (contrôleur "billing") et formule mise en avant à bordure animée. -#}
{%- props
    ## string Heading.
    title = 'Choisissez votre formule',
    ## string Label of the yearly saving.
    saving = '2 mois offerts',
    ## array<array{name: string, monthly: string, yearly: string, description: string, features: array<string>, cta: string, href: string, featured?: bool}> Plans. "yearly" is the monthly price when billed yearly.
    plans = [
        {name: 'Solo', monthly: '0 €', yearly: '0 €', description: 'Pour démarrer.', features: ['5 factures par mois', 'Devis illimités', 'Paiement par lien'], cta: 'Commencer', href: '#'},
        {name: 'Pro', monthly: '19 €', yearly: '16 €', description: 'Pour les indépendants installés.', features: ['Factures illimitées', 'Relances automatiques', 'Rapprochement bancaire', 'Export comptable'], cta: 'Essayer 14 jours', href: '#', featured: true},
        {name: 'Équipe', monthly: '49 €', yearly: '41 €', description: 'Pour les agences et cabinets.', features: ['Tout le plan Pro', '5 utilisateurs', 'Rôles et validations', 'Support prioritaire'], cta: 'Nous contacter', href: '#'},
    ]
-%}
<section {{ attributes.defaults({class: 'px-4 py-20 sm:px-6'|tailwind_classes}) }} data-controller="billing" data-billing="monthly">
    <div class="mx-auto max-w-6xl">
        <div class="flex flex-col items-center text-center">
            <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{{ title }}</h2>
            <div class="mt-6 flex items-center gap-3 text-sm">
                <span id="billing-monthly">Mensuel</span>
                <button type="button" role="switch" aria-checked="false" aria-labelledby="billing-yearly" data-billing-target="switch" data-action="billing#toggle"
                    class="relative h-6 w-11 rounded-full bg-input transition-colors aria-checked:bg-primary focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none">
                    <span class="absolute start-0.5 top-0.5 size-5 rounded-full bg-background shadow transition-transform duration-200 [[aria-checked=true]>&]:translate-x-5 rtl:[[aria-checked=true]>&]:-translate-x-5"></span>
                </button>
                <span id="billing-yearly">Annuel <twig:Badge variant="secondary" class="ms-1">{{ saving }}</twig:Badge></span>
            </div>
        </div>
        <div class="mt-12 grid gap-6 lg:grid-cols-3 lg:items-start">
            {%- for plan in plans %}
                {%- set featured = plan.featured ?? false %}
                <div class="{{ featured ? 'tb-beam lg:-mt-4' : '' }} flex flex-col rounded-2xl border bg-card p-7">
                    <div class="flex items-center justify-between"><h3 class="font-semibold">{{ plan.name }}</h3>{% if featured %}<twig:Badge>Le plus choisi</twig:Badge>{% endif %}</div>
                    <p class="mt-1 text-sm text-muted-foreground">{{ plan.description }}</p>
                    <p class="mt-6 flex items-baseline gap-1">
                        <span class="text-4xl font-semibold tracking-tight tabular-nums" data-billing-target="price" data-monthly="{{ plan.monthly }}" data-yearly="{{ plan.yearly }}" aria-live="polite">{{ plan.monthly }}</span>
                        <span class="text-sm text-muted-foreground" data-billing-target="period" data-monthly="/mois" data-yearly="/mois, facturé à l’année">/mois</span>
                    </p>
                    <twig:Button as="a" href="{{ plan.href }}" size="lg" variant="{{ featured ? 'default' : 'outline' }}" class="mt-6 w-full">{{ plan.cta }}</twig:Button>
                    <ul class="mt-7 space-y-2.5 text-sm">
                        {%- for f in plan.features %}<li class="flex gap-2"><twig:ux:icon name="lucide:check" class="mt-0.5 size-4 shrink-0 text-primary" />{{ f }}</li>{% endfor %}
                    </ul>
                </div>
            {%- endfor %}
        </div>
    </div>
</section>
